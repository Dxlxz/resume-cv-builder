{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals", "node"],
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@rb/core": ["packages/core/src"],
      "@rb/core/*": ["packages/core/src/*"],
      "@rb/layout": ["packages/layout/src"],
      "@rb/layout/*": ["packages/layout/src/*"],
      "@rb/render": ["packages/render/src"],
      "@rb/render/*": ["packages/render/src/*"],
      "@rb/styles": ["packages/styles/src"],
      "@rb/styles/*": ["packages/styles/src/*"],
      "@rb/templates": ["packages/templates/src"],
      "@rb/templates/*": ["packages/templates/src/*"],
      "@rb/themes": ["packages/themes/src"],
      "@rb/themes/*": ["packages/themes/src/*"],
      "@rb/validators": ["packages/validators/src"],
      "@rb/validators/*": ["packages/validators/src/*"],
      "@rb/presets": ["packages/presets/src"],
      "@rb/presets/*": ["packages/presets/src/*"],
      "@rb/catalog": ["packages/catalog/src"],
      "@rb/catalog/*": ["packages/catalog/src/*"],
      "@rb/fixtures": ["packages/fixtures/src"],
      "@rb/fixtures/*": ["packages/fixtures/src/*"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
